<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PerforMetrix AI Audit — Diagnostic</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root{
      --ink:#14171F;
      --ink-2:#1B2029;
      --ink-3:#242A38;
      --ink-line:#333B4C;
      --ink-text:#E8E4DA;
      --ink-text-dim:#9AA3B5;
      --paper:#F5F1E7;
      --paper-2:#ECE5D4;
      --paper-line:#D8CFB8;
      --paper-text:#221F1A;
      --brass:#B4915B;
      --brass-light:#D8BE8F;
      --rust:#B65C3F;
      --sage:#7C9082;
      --flag:#7A2E2E;
      --font-display:'Fraunces', Georgia, serif;
      --font-body:'Inter', -apple-system, sans-serif;
      --font-mono:'IBM Plex Mono', monospace;
    }
    *{box-sizing:border-box;}
    body{margin:0;font-family:var(--font-body);background:var(--ink);color:var(--ink-text);}
    a{color:var(--brass-light);text-decoration:none;}
    .shell{max-width:840px;margin:0 auto;padding:48px 32px 80px;}
    .eyebrow{font-family:var(--font-mono);font-size:11px;letter-spacing:0.14em;text-transform:uppercase;opacity:0.65;margin-bottom:10px;}
    .h1{font-family:var(--font-display);font-weight:500;font-size:34px;line-height:1.15;margin:0 0 6px;}
    .sub{font-size:14.5px;line-height:1.6;opacity:0.75;max-width:520px;margin:0 0 32px;}
    .panel{background:var(--ink-2);border:1px solid var(--ink-line);border-radius:3px;padding:24px 26px;margin-bottom:20px;}
    .panel-title{font-family:var(--font-mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;opacity:0.6;margin-bottom:16px;}
    .btn{font-family:var(--font-mono);font-size:11.5px;letter-spacing:0.06em;text-transform:uppercase;padding:11px 18px;border-radius:2px;border:1px solid var(--brass);background:var(--brass);color:var(--ink);cursor:pointer;white-space:nowrap;transition:opacity .15s;display:inline-block;}
    .btn:hover{opacity:0.85;}
    .btn-ghost{background:transparent;color:var(--brass-light);border:1px solid var(--ink-line);}
    .btn-ghost:hover{border-color:var(--brass);}
    .field{margin-bottom:20px;}
    .field label{font-family:var(--font-mono);font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase;opacity:0.6;display:block;margin-bottom:6px;}
    .field input{background:var(--ink-3);border:1px solid var(--ink-line);color:var(--ink-text);padding:11px 14px;border-radius:2px;width:100%;font-family:var(--font-body);font-size:14px;}
    .form-error{color:var(--rust);font-size:13px;margin-top:6px;}
    .nav{display:flex;align-items:center;justify-content:space-between;padding:24px 32px;border-bottom:1px solid var(--ink-line);margin-bottom:40px;background:var(--ink-2);}
    .logo{display:flex;align-items:center;gap:12px;}
    .logo img{height:32px;width:auto;}
    .brand{font-family:var(--font-display);font-weight:600;font-size:20px;color:var(--brass-light);}
    .status-pill{font-family:var(--font-mono);font-size:10px;letter-spacing:0.08em;text-transform:uppercase;padding:4px 9px;border-radius:12px;display:inline-block;}
    .status-done{background:rgba(124,144,130,0.15);color:var(--sage);border:1px solid rgba(124,144,130,0.4);}
    .status-pending{background:rgba(180,145,91,0.15);color:var(--brass-light);border:1px solid rgba(180,145,91,0.4);}
  </style>
</head>
<body>
  <nav class="nav">
    <div class="logo"><img src="/logo.png" alt="PerforMetrix" /></div>
    <div style="display:flex;gap:16px;align-items:center;">
      <a href="/survey" style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.06em;text-transform:uppercase;color:var(--ink-text-dim);">Diagnostic</a>
      <a href="/admin" style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.06em;text-transform:uppercase;color:var(--ink-text-dim);">Admin</a>
      <a href="/logout" class="btn-ghost" style="padding:6px 12px;">Sign out</a>
    </div>
  </nav>
  <main class="shell">
    <div class="panel">
      <div class="panel-title">AI Maturity Diagnostic</div>
      <div class="sub">Answer all 15 questions. Think about what you actually see happening in your organisation, not what you wish were true.</div>
      <% if (typeof error !== 'undefined' && error) { %><p class="form-error"><%= error %></p><% } %>
      <form action="/survey" method="post">
        <% DIMENSION_ORDER.forEach(function(key) { %>
          <div class="panel" style="margin-top:24px;">
            <div style="font-family:var(--font-display);font-size:18px;margin-bottom:8px;">
              <% if (key === 'vision') { %>Vision and strategy<% } %>
              <% if (key === 'criteria') { %>Criteria and goals<% } %>
              <% if (key === 'manager') { %>Manager capability<% } %>
              <% if (key === 'accountability') { %>Accountability and guardrails<% } %>
              <% if (key === 'culture') { %>Culture and trust<% } %>
            </div>
            <% questions.filter(function(q){ return q.key.startsWith(key + '-'); }).forEach(function(q) { %>
              <div class="field" style="margin-bottom:16px;">
                <label style="font-size:13px;opacity:0.9;"><%= q.text %></label>
                <div style="display:flex;gap:8px;">
                  <% for(var i=1;i<=5;i++) { %>
                    <label style="display:flex;align-items:center;gap:4px;cursor:pointer;opacity:0.8;">
                      <input type="radio" name="<%= q.key %>" value="<%= i %>" required style="accent-color:var(--brass);" />
                      <span><%= i === 1 ? 'Never' : i === 5 ? 'Always' : i %></span>
                    </label>
                  <% } %>
                </div>
              </div>
            <% }); %>
          </div>
        <% }); %>
        <button type="submit" class="btn" style="margin-top:24px;">Get my report</button>
      </form>
    </div>
  </main>
</body>
</html>