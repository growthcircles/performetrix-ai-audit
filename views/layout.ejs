<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PerforMetrix AI Audit</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root{
      --ink:#14171F;
      --ink-2:#1B2029;
      --ink-3:#242A38;
      --ink-line:#333B4C;
      --ink-text:#E8E4DA;
      --ink-text-dim:#9AA3B5;
      --paper:#F5F1E7;
      --paper-2:#ECE5D4;
      --paper-line:#D8CFB8;
      --paper-text:#221F1A;
      --brass:#B4915B;
      --brass-light:#D8BE8F;
      --rust:#B65C3F;
      --sage:#7C9082;
      --flag:#7A2E2E;
      --font-display:'Fraunces', Georgia, serif;
      --font-body:'Inter', -apple-system, sans-serif;
      --font-mono:'IBM Plex Mono', monospace;
    }
    *{box-sizing:border-box;}
    body{margin:0;font-family:var(--font-body);background:var(--ink);color:var(--ink-text);}
    a{color:var(--brass-light);text-decoration:none;}
    .shell{max-width:840px;margin:0 auto;padding:48px 32px 80px;}
    .eyebrow{font-family:var(--font-mono);font-size:11px;letter-spacing:0.14em;text-transform:uppercase;opacity:0.65;margin-bottom:10px;}
    .h1{font-family:var(--font-display);font-weight:500;font-size:34px;line-height:1.15;margin:0 0 6px;}
    .sub{font-size:14.5px;line-height:1.6;opacity:0.75;max-width:520px;margin:0 0 32px;}
    .panel{background:var(--ink-2);border:1px solid var(--ink-line);border-radius:3px;padding:24px 26px;margin-bottom:20px;}
    .panel-title{font-family:var(--font-mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;opacity:0.6;margin-bottom:16px;}
    .btn{font-family:var(--font-mono);font-size:11.5px;letter-spacing:0.06em;text-transform:uppercase;padding:11px 18px;border-radius:2px;border:1px solid var(--brass);background:var(--brass);color:var(--ink);cursor:pointer;white-space:nowrap;transition:opacity .15s;display:inline-block;}
    .btn:hover{opacity:0.85;}
    .btn-ghost{background:transparent;color:var(--brass-light);border:1px solid var(--ink-line);}
    .btn-ghost:hover{border-color:var(--brass);}
    .field{margin-bottom:20px;}
    .field label{font-family:var(--font-mono);font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase;opacity:0.6;display:block;margin-bottom:6px;}
    .field input{background:var(--ink-3);border:1px solid var(--ink-line);color:var(--ink-text);padding:11px 14px;border-radius:2px;width:100%;font-family:var(--font-body);font-size:14px;}
    .form-error{color:var(--rust);font-size:13px;margin-top:6px;}
    .back-link{font-family:var(--font-mono);font-size:11.5px;letter-spacing:0.04em;text-transform:uppercase;opacity:0.6;cursor:pointer;display:inline-block;margin-bottom:24px;}
    .status-pill{font-family:var(--font-mono);font-size:10px;letter-spacing:0.08em;text-transform:uppercase;padding:4px 9px;border-radius:12px;display:inline-block;}
    .status-done{background:rgba(124,144,130,0.15);color:var(--sage);border:1px solid rgba(124,144,130,0.4);}
    .status-pending{background:rgba(180,145,91,0.15);color:var(--brass-light);border:1px solid rgba(180,145,91,0.4);}
    .leader-row{display:flex;align-items:center;justify-content:space-between;padding:16px 0;border-bottom:1px solid var(--ink-line);}
    .leader-row:last-child{border-bottom:none;}
    .leader-name{font-family:var(--font-display);font-size:16.5px;}
    .leader-meta{font-family:var(--font-mono);font-size:10.5px;opacity:0.5;}
    .row-actions{display:flex;align-items:center;gap:14px;}
    .empty-note{font-size:13.5px;opacity:0.5;}
  </style>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="shell">
    <%- body %>
  </main>
</body>
</html>