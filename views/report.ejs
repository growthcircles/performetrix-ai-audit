<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PerforMetrix AI Audit — Maturity Report</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root{
      --ink:#14171F;
      --ink-2:#1B2029;
      --ink-3:#242A38;
      --ink-line:#333B4C;
      --ink-text:#E8E4DA;
      --ink-text-dim:#9AA3B5;
      --paper:#F5F1E7;
      --paper-2:#ECE5D4;
      --paper-line:#D8CFB8;
      --paper-text:#221F1A;
      --brass:#B4915B;
      --brass-light:#D8BE8F;
      --rust:#B65C3F;
      --sage:#7C9082;
      --flag:#7A2E2E;
      --font-display:'Fraunces', Georgia, serif;
      --font-body:'Inter', -apple-system, sans-serif;
      --font-mono:'IBM Plex Mono', monospace;
    }
    *{box-sizing:border-box;}
    body{margin:0;font-family:var(--font-body);background:var(--ink);color:var(--ink-text);}
    a{color:var(--brass-light);text-decoration:none;}
    .shell{max-width:840px;margin:0 auto;padding:48px 32px 80px;}
    .nav{display:flex;align-items:center;justify-content:space-between;padding:24px 32px;border-bottom:1px solid var(--ink-line);margin-bottom:40px;background:var(--ink-2);}
    .logo{display:flex;align-items:center;gap:12px;}
    .logo img{height:32px;width:auto;}
    .back-link{font-family:var(--font-mono);font-size:11.5px;letter-spacing:0.04em;text-transform:uppercase;opacity:0.6;cursor:pointer;display:inline-block;margin-bottom:24px;}
    .panel{background:var(--ink-2);border:1px solid var(--ink-line);border-radius:3px;padding:24px 26px;margin-bottom:20px;}
    .panel-title{font-family:var(--font-mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;opacity:0.6;margin-bottom:16px;}
    .eyebrow{font-family:var(--font-mono);font-size:11px;letter-spacing:0.14em;text-transform:uppercase;opacity:0.65;margin-bottom:10px;}
    .h1{font-family:var(--font-display);font-weight:500;font-size:34px;line-height:1.15;margin:0 0 6px;}
    .sub{font-size:14.5px;line-height:1.6;opacity:0.75;max-width:520px;margin:0 0 32px;}
    .delivery-line{font-family:var(--font-mono);font-size:11.5px;opacity:0.55;margin-bottom:30px;}
    .score-hero{display:flex;align-items:baseline;gap:18px;margin-bottom:44px;padding-bottom:32px;border-bottom:1px solid var(--ink-line);}
    .score-big{font-family:var(--font-display);font-size:76px;font-weight:500;line-height:1;color:var(--brass-light);}
    .score-big-label{font-family:var(--font-mono);font-size:12px;text-transform:uppercase;letter-spacing:0.08em;opacity:0.6;}
    .band-badge{font-family:var(--font-mono);font-size:13px;letter-spacing:0.06em;text-transform:uppercase;color:var(--ink-text-dim);margin-top:6px;}
    .band-badge.ad-hoc,.band-badge.reactive{color:var(--rust);}
    .band-badge.building{color:var(--brass);}
    .band-badge.embedded,.band-badge.leading{color:var(--sage);}
    .gauge-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-bottom:40px;}
    .gauge-card{background:var(--ink-2);border:1px solid var(--ink-line);border-radius:3px;padding:18px 12px;text-align:center;}
    .gauge-wrap{position:relative;width:80px;height:80px;margin:0 auto 10px;}
    .gauge-svg{width:80px;height:80px;transform:rotate(-90deg);}
    .gauge-circle-bg{fill:none;stroke:var(--ink-line);stroke-width:8;}
    .gauge-circle{fill:none;stroke-linecap:round;stroke-width:8;transition:stroke-dashoffset 0.6s ease;}
    .gauge-value{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:20px;color:var(--ink-text);}
    .gauge-name{font-family:var(--font-display);font-size:13px;margin-bottom:4px;}
    .gauge-band{font-family:var(--font-mono);font-size:9px;letter-spacing:0.06em;text-transform:uppercase;margin-top:2px;}
    .gauge-card.flagged .gauge-circle{stroke:var(--rust);}
    .gauge-card.flagged .gauge-band{color:var(--rust);}
    .gauge-card.on-track .gauge-circle{stroke:var(--sage);}
    .gauge-card.on-track .gauge-band{color:var(--sage);}
    .legend-panel{background:var(--ink-2);border:1px solid var(--ink-line);border-radius:3px;padding:22px 24px;margin-bottom:36px;}
    .legend-title{font-family:var(--font-mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;opacity:0.6;margin-bottom:14px;}
    .legend-list{font-size:13px;line-height:1.7;opacity:0.85;margin:0 0 16px;padding-left:18px;}
    .legend-list li{margin-bottom:6px;}
    .legend-swatches{display:flex;gap:24px;padding-top:14px;border-top:1px solid var(--ink-line);}
    .legend-swatch{display:flex;align-items:center;gap:8px;font-size:12px;opacity:0.8;}
    .legend-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
    .dot-brass{background:var(--brass);}
    .dot-rust{background:var(--rust);}
    .impact-summary{border:1px solid var(--rust);background:rgba(182,92,63,0.08);border-radius:3px;padding:22px 24px;margin-bottom:36px;}
    .impact-summary-title{font-family:var(--font-mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:14px;color:var(--rust);}
    .impact-item{margin-bottom:14px;}
    .impact-item:last-child{margin-bottom:0;}
    .impact-item-name{font-family:var(--font-display);font-size:15px;margin-bottom:4px;}
    .impact-item-text{font-size:13px;line-height:1.6;opacity:0.85;}
    .cta-panel{background:var(--ink-2);border:1px solid var(--brass);border-radius:3px;padding:24px 26px;margin-bottom:36px;}
    .cta-title{font-family:var(--font-display);font-size:18px;margin-bottom:10px;}
    .cta-text{font-size:14px;line-height:1.7;opacity:0.9;margin-bottom:20px;}
    .cta-btn{font-family:var(--font-mono);font-size:11.5px;letter-spacing:0.06em;text-transform:uppercase;padding:12px 24px;border-radius:2px;border:1px solid var(--brass);background:var(--brass);color:var(--ink);cursor:pointer;white-space:nowrap;display:inline-block;}
    .cta-btn:hover{opacity:0.85;}
    .method-note{font-size:12px;line-height:1.7;opacity:0.5;margin-top:40px;padding-top:24px;border-top:1px solid var(--ink-line);}
  </style>
</head>
<body>
  <nav class="nav">
    <div class="logo"><img src="/logo.png" alt="PerforMetrix" /></div>
  </nav>
  <main class="shell">
    <div class="eyebrow">AI Maturity Diagnostic Report</div>
    <div class="h1"><%= submission.result.userName %></div>
    <div class="delivery-line">Organisation: <%= user.organisation %> &nbsp;&middot;&nbsp; Report generated today</div>

    <div class="legend-panel">
      <div class="legend-title">How to read this report</div>
      <ul class="legend-list">
        <li>Your overall AI maturity score is the average of the five dimension scores below, each scored out of 100.</li>
        <li>Scores at or below 80 are flagged as priority gaps — the areas where your organisation is most exposed.</li>
        <li>This is a diagnostic for where to focus, not a final verdict.</li>
      </ul>
      <div class="legend-swatches">
        <div class="legend-swatch"><div class="legend-dot dot-brass"></div>Score above 80, on track</div>
        <div class="legend-swatch"><div class="legend-dot dot-rust"></div>Score at or below 80, priority gap</div>
      </div>
    </div>

    <div class="score-hero">
      <div class="score-big"><%= submission.result.overall %></div>
      <div>
        <div class="score-big-label">Overall AI maturity score</div>
        <div class="band-badge <%= submission.result.band.key %>"><%= submission.result.band.name %></div>
        <div style="font-size:12.5px;opacity:0.6;margin-top:4px;"><%= submission.result.band.description %></div>
      </div>
    </div>

    <div class="gauge-grid">
      <% submission.result.dimensions.forEach(function(dim) { %>
        <div class="gauge-card <%= dim.score > 80 ? 'on-track' : 'flagged' %>">
          <div class="gauge-wrap">
            <svg class="gauge-svg" viewBox="0 0 80 80">
              <circle class="gauge-circle-bg" cx="40" cy="40" r="32"/>
              <circle class="gauge-circle" cx="40" cy="40" r="32" stroke="<%= dim.score > 80 ? '#7C9082' : '#B65C3F' %>" stroke-dasharray="201" stroke-dashoffset="<%= 201 * (1 - dim.score/100) %>"/>
            </svg>
            <div class="gauge-value"><%= dim.score %></div>
          </div>
          <div class="gauge-name"><%= dim.name %></div>
          <div class="gauge-band <%= dim.score > 80 ? 'on-track' : 'flagged' %>"><%= dim.score > 80 ? 'On track' : 'Priority gap' %></div>
        </div>
      <% }); %>
    </div>

    <% if (submission.result.dimensions.some(function(d){ return d.score <= 80; })) { %>
    <div class="impact-summary">
      <div class="impact-summary-title">What this could mean for <%= user.organisation %></div>
      <% submission.result.dimensions.forEach(function(dim) { %>
        <% if (dim.score <= 80) { %>
        <div class="impact-item">
          <div class="impact-item-name"><%= dim.name %></div>
          <div class="impact-item-text"><%= dim.band.description %></div>
        </div>
        <% } %>
      <% }); %>
    </div>
    <% } %>

    <div class="cta-panel">
      <div class="cta-title">Your results show gaps that warrant a closer conversation.</div>
      <div class="cta-text">
        Five dimensions were assessed. <% var flagged = submission.result.dimensions.filter(function(d){ return d.score <= 80; }); %><%= flagged.length %> sit below the priority threshold. <% if (flagged.length > 0) { %>That means your organisation is exposed across the board — from vision to culture — and the implications compound: inconsistent quality, unresolved disputes, unmanaged risk, and blind spots that compound over time.<% } else { %>You are holding up well across all five dimensions.<% } %>
        <br><br>
        We help organisations close these gaps. If you would like to discuss what these findings mean for your organisation and what to do about them, book a call.
      </div>
      <a href="https://cal.com/growthcircles/multiplesessions" target="_blank" rel="noopener noreferrer" class="cta-btn">Book a meeting</a>
    </div>

    <div class="method-note">
      Scores are calculated from 15 behaviour-based questions answered about your organisation. Each dimension is scored 0-100 based on how common the behaviour is. The overall score is the average of the five dimensions and tracks progress over time.
    </div>
  </main>
</body>
</html>
