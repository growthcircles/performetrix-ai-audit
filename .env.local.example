# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key - server-only, bypasses RLS. Never expose to the client.
# Used only for the unauthenticated leader-token assessment flow.
SUPABASE_SECRET_KEY=

# Base URL used to build leader assessment links (https://.../a/<token>)
NEXT_PUBLIC_APP_URL=http://localhost:3000
